APP_NAME="Orcha Journey"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://orchajourney.com

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=orcha
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=halo@orchajourney.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="halo@orchajourney.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Kontak yang dipakai tombol WhatsApp / footer di landing page
ORCHA_WHATSAPP=62895630279695
ORCHA_EMAIL=halo@orchajourney.com
ORCHA_INSTAGRAM=orcha_journey
ORCHA_ALAMAT="Perumahan GWI, Jl. Durian No. 115, Banguntapan, Bantul, Yogyakarta"
# Badan hukum di balik merek, dipakai di baris hak cipta footer.
ORCHA_PERUSAHAAN="PT Asthana Cipta Mandiri"
ORCHA_PERUSAHAAN_SITUS=https://asthanaciptamandiri.com/

# API dashboard — dipakai admin Phoenix ("lemon by acm")
# Isi dengan rahasia acak panjang, sama persis di kedua aplikasi.
# Buat dengan: php artisan orcha:kunci-api
ORCHA_API_KEY=
# Batasi ke IP server Phoenix (pisahkan dengan koma). Kosong = tidak dibatasi.
ORCHA_API_IP=

# Panel admin bawaan Orcha (login /admin/*) — DIMATIKAN.
# Pengelolaan ada di dashboard lemon. Setel true hanya bila lemon bermasalah.
ORCHA_ADMIN_BAWAAN=false

# Alamat penerima pemberitahuan formulir (pendaftaran, bukti bayar, riwayat
# kesehatan, pembatalan). Kosong = pemberitahuan tidak dikirim.
ORCHA_EMAIL_PEMBERITAHUAN=halo@orchajourney.com
ORCHA_EMAIL_SALINAN_PELANGGAN=true

# Kunci OpenRouteService untuk jarak jalan di formulir sewa.
# Tanpa ini, petanya tetap tampil; yang hilang hanya angka jaraknya.
ORCHA_RUTE_KUNCI=

# --- Cadangan basis data ke Google Drive ---
# Penyiapannya diterangkan di config/orcha.php pada kunci 'drive'.
# Refresh token didapat sekali lewat: php artisan orcha:drive-izin
# Dikosongkan = cadangan tetap dibuat, hanya tersimpan di server saja.
ORCHA_DRIVE_CLIENT_ID=
ORCHA_DRIVE_CLIENT_SECRET=
ORCHA_DRIVE_REFRESH_TOKEN=
ORCHA_DRIVE_FOLDER=

# --- Gerbang pembayaran DOKU (Checkout, non-SNAP) ---
# Kredensialnya diambil dari dashboard DOKU: Pengaturan → API Keys.
# Yang dipakai HANYA dua: Client ID dan Secret Key. "Merchant Public Key" dan
# "Pengaturan SNAP → Token URL" milik jalur SNAP yang bertanda tangan RSA, dan
# tidak tersentuh integrasi ini — biarkan kosong di dashboard.
#
# Kredensial sandbox dan produksi BERBEDA dan tidak bisa saling dipakai.
DOKU_AKTIF=false
DOKU_LINGKUNGAN=sandbox
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Umur halaman pembayaran (menit). Harus jauh di bawah orcha.pembayaran.dp_lepas_jam.
DOKU_BATAS_BAYAR_MENIT=30
DOKU_BATAS_TUNGGU=15
DOKU_TENGGANG_PERIKSA_MENIT=15
DOKU_JENDELA_NOTIFIKASI_MENIT=30
# Kosong = semua channel yang aktif di akun DOKU ditampilkan. Isi hanya bila
# sengaja ingin membatasi, dipisah koma: QRIS,VIRTUAL_ACCOUNT_BCA
DOKU_METODE=
